#!/bin/sh
# Blocks commits that would leak secrets or personal data.
# Installed (copied, together with a pinned copy of check_secrets.py) into .git/hooks
# by scripts/install-hooks.sh. Repo changes have no effect until you re-install.
set -e
HOOKS=$(cd "$(dirname "$0")" && pwd)
cd "$(git rev-parse --show-toplevel)"
python3 -I "$HOOKS/check_secrets.py" --staged --require-local
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --exit-code 1 .
else
  echo "pre-commit: gitleaks is not installed, so only the built-in leak check ran." >&2
fi

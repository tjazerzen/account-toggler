[Unit]
Description=Account toggler: Claude Code + Codex account switcher web UI and auto-switch
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/code/account-toggler
# All settings (password, port, account order, ...) come from .env in WorkingDirectory.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 %h/code/account-toggler/server.py
SyslogIdentifier=account-toggler
Restart=on-failure
RestartSec=3
UMask=0077
TasksMax=128
MemoryMax=256M
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=default.target

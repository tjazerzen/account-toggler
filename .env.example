# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit real values.

# Password you type on the sign-in page (20+ chars; generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(20))"
MASTER_PASSWORD=change-me
# Signs login cookies (32+ chars). Change it to sign every browser out.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

PORT=8765
# Auto-switch order: first = preferred account, used again once its limit resets.
PRIORITY=main,backup
THRESHOLD=90
POLL_SECONDS=60

# Only when serving on a domain: a second listener for your reverse proxy (Cloudflare
# Tunnel, Caddy, nginx) running on this machine. Point the proxy at PUBLIC_PORT, never PORT.
# PUBLIC_PORT=8767
# ALLOWED_HOSTS=claude.example.com
